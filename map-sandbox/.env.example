# map-sandbox frontend. Copy to `.env` in this same directory.
#
#   docker compose -f map-sandbox/docker-compose.yml up -d --build
#
# BUILD-TIME arg, baked into the static bundle by Vite. Runs in the
# visitor's browser -- must be a URL the browser can reach, NOT a container
# name, NOT localhost on the VPS. Rebuild the image after changing it.
#
# Local dev:  http://localhost:8092
# VPS:        map-api's public URL, e.g. https://evebazaar.com/api/map
VITE_MAP_API_BASE_URL=http://localhost:8092
