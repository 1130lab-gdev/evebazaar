# catalog-api -- docker-compose.yml auto-loads catalog-api/.env from this
# directory. Copy this file to .env and fill in.
#
#   local:  docker compose up -d --build
#   VPS:    docker compose pull && docker compose up -d
#
# POSTGRES_USER / POSTGRES_PASSWORD are REQUIRED (compose won't start
# without them) and must match database/database/.env. POSTGRES_DB defaults
# to "eve". catalog-api is read-only against this DB.
POSTGRES_USER=eve
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=eve

# Postgres location on evebazaar-network. Defaults are the evebazaar-database
# container on port 5432 -- only set these for an off-box / managed Postgres.
#POSTGRES_HOST=evebazaar-database
#POSTGRES_PORT=5432

# Overrides the assembled connection string entirely (managed Postgres,
# sslmode, etc). Wins over the POSTGRES_* parts above.
#DATABASE_URL=postgres://user:pass@host:5432/eve?sslmode=require

# Path prefix this service serves everything under (API, Swagger UI,
# OpenAPI JSON). Set on the VPS so a single-domain reverse proxy can
# forward /api/catalog/* here WITHOUT stripping the prefix. Empty = serve
# at root (local dev).
#API_BASE_PATH=/api/catalog

# --- VPS only -----------------------------------------------------------
# Registry the catalog-api image is pulled from (leave unset locally).
# Trailing host[:port], no slash.
#REGISTRY=registry.example.com
#TAG=latest
