# map-api -- docker-compose.yml auto-loads map-api/.env from this directory.
# Copy this file to .env and fill in.
#
#   local:  docker compose up -d --build
#   VPS:    docker compose pull && docker compose up -d
#
# POSTGRES_USER / POSTGRES_PASSWORD are REQUIRED and must match
# database/database/.env. POSTGRES_DB defaults to "eve". map-api is
# read-only against this DB.
POSTGRES_USER=eve
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=eve

# Postgres location on evebazaar-network. Defaults are the evebazaar-database
# container on port 5432 -- only set these for an off-box / managed Postgres.
#POSTGRES_HOST=evebazaar-database
#POSTGRES_PORT=5432

# Overrides the assembled connection string entirely. Wins over the parts.
#DATABASE_URL=postgres://user:pass@host:5432/eve?sslmode=require

# Path prefix this service serves everything under (API, Swagger UI,
# OpenAPI JSON). Set on the VPS so a single-domain reverse proxy can
# forward /api/map/* here WITHOUT stripping the prefix. Empty = serve at
# root (local dev).
#API_BASE_PATH=/api/map

# --- VPS only -----------------------------------------------------------
#REGISTRY=registry.example.com
#TAG=latest
