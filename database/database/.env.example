POSTGRES_USER=eve
POSTGRES_PASSWORD=eve
POSTGRES_DB=eve

# Name of the external volume holding /var/lib/postgresql/data. Leave unset
# locally -- defaults to the volume this dev box already has data in
# (database_eve-db-data). On the VPS, set this to a volume you create
# yourself, e.g.:
#   docker volume create evebazaar-db-data
#   DB_DATA_VOLUME=evebazaar-db-data
#DB_DATA_VOLUME=evebazaar-db-data
