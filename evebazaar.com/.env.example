# Base URL of the exchange-webapi service (see ../exchange-webapi/src/config.rs).
# Defaults to http://localhost:8080 in src/api/client.ts if unset.
VITE_API_BASE_URL=http://localhost:8080

# Base URL of the catalog-api service (see ../catalog-api/src/config.rs).
# Defaults to http://localhost:8091 in src/api/catalog/client.ts if unset.
VITE_CATALOG_API_BASE_URL=http://localhost:8091

# Base URL of the map-api service (see ../map-api/src/config.rs).
# Defaults to http://localhost:8092 in src/api/map/client.ts if unset.
VITE_MAP_API_BASE_URL=http://localhost:8092
