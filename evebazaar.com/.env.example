# evebazaar.com frontend. Copy to `.env` in this same directory.
#
#   docker compose -f evebazaar.com/docker-compose.yml up -d --build
#
# BUILD-TIME args, baked into the static bundle by Vite. They run in the
# visitor's browser. Rebuild the image after changing them (`--build`).
#
# Local dev:  the APIs run at the root of their own ports.
#   VITE_CATALOG_API_BASE_URL=http://localhost:8091
#   VITE_MAP_API_BASE_URL=http://localhost:8092
#
# VPS (single domain): the APIs sit behind the same-origin reverse proxy
# under /api/catalog and /api/map (they serve themselves under that prefix
# via API_BASE_PATH -- see catalog-api/.env / map-api/.env). Use relative
# paths so calls stay same-origin, no CORS:
#   VITE_CATALOG_API_BASE_URL=/api/catalog
#   VITE_MAP_API_BASE_URL=/api/map
VITE_CATALOG_API_BASE_URL=http://localhost:8091
VITE_MAP_API_BASE_URL=http://localhost:8092

# --- VPS only -----------------------------------------------------------
# Registry the built frontend image is pulled from (leave unset locally).
#REGISTRY=registry.example.com
#TAG=latest
